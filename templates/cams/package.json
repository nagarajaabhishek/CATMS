{
  "name": "{PROJECT_NAME}-cams",
  "version": "3.0.0",
  "private": true,
  "description": "CAMS (Coding Agent Memory System) \u2014 local, git-backed shared memory MCP server for {PROJECT_NAME} (Claude Code + Cursor + Antigravity).",
  "type": "module",
  "main": "server.ts",
  "scripts": {
    "start": "tsx server.ts",
    "backfill": "tsx server.ts --backfill",
    "rebuild": "tsx server.ts --backfill --rebuild",
    "import": "tsx server.ts --import",
    "query": "tsx server.ts --query",
    "eval": "tsx eval/run.ts",
    "report": "tsx report.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^20.17.9",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
