#!/bin/bash
# CATMS post-merge git hook
# Auto-runs CAMS backfill whenever new changes are pulled, keeping semantic memory
# in sync with git state. Installed manually by the developer (not cloned).

# Fail gracefully if tools/cams doesn't exist or npm isn't available
if [ ! -d "tools/cams" ]; then
  exit 0
fi

if ! command -v npm &> /dev/null; then
  exit 0
fi

# Run backfill silently. If it fails, print a reminder but don't abort the merge.
cd tools/cams
if npm run backfill > /dev/null 2>&1; then
  : # Success, silent
else
  echo ""
  echo "⚠️  CAMS backfill failed after git merge"
  echo "   Run manually: cd tools/cams && npm run backfill"
  echo ""
fi

exit 0
