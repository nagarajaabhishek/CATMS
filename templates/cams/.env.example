# CAMS embedding provider config — catms init / catms setup write the real
# tools/cams/.env with your own provider/key (never committed). This file is a
# reference for what that looks like, and a starting point if you ever need
# to switch providers manually.

# EMBED_PROVIDER = openai | voyage | ollama
EMBED_PROVIDER=openai

# --- openai (default) ---
OPENAI_API_KEY=
OPENAI_EMBED_MODEL=text-embedding-3-small

# --- voyage ---
# VOYAGE_API_KEY=
# VOYAGE_EMBED_MODEL=voyage-3-lite

# --- ollama (local, no API key — requires `ollama pull mxbai-embed-large`) ---
# OLLAMA_HOST=http://127.0.0.1:11434
# OLLAMA_EMBED_MODEL=mxbai-embed-large

# Switching EMBED_PROVIDER on a project that already has memory.ndjson: re-run
# `npm run backfill` (or the cams_backfill MCP tool) to re-embed. Until then,
# old-model chunks are found by keyword search only.
#
# Superseded (changed/deleted) chunks kept for cams_history before pruning:
# CAMS_HISTORY_MAX=5000
#
# Commits read when history is rebuilt from git (fresh clone, npm run rebuild):
# CAMS_HISTORY_COMMITS=500
#
# Author recorded on cams_ingest facts (default: git config catms.claimTag,
# then git user.email):
# CAMS_AUTHOR=@you
