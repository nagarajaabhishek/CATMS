# CAMS embedding provider config — catms init writes the real tools/cams/.env
# directly with your chosen provider/key (never committed). This file is a
# reference for what that looks like, and a starting point if you ever need
# to switch providers manually.

# EMBED_PROVIDER = openai | voyage | ollama
EMBED_PROVIDER=openai

# --- openai (default) ---
OPENAI_API_KEY=
OPENAI_EMBED_MODEL=text-embedding-3-small

# --- voyage ---
# VOYAGE_API_KEY=
# VOYAGE_EMBED_MODEL=voyage-3-lite

# --- ollama (local, no API key — requires `ollama pull mxbai-embed-large`) ---
# OLLAMA_HOST=http://127.0.0.1:11434
# OLLAMA_EMBED_MODEL=mxbai-embed-large

# Switching EMBED_PROVIDER on a project that already has memory.ndjson
# invalidates its vectors — delete memory.ndjson and re-run `npm run backfill`
# (or the cams_backfill MCP tool) after a change.
